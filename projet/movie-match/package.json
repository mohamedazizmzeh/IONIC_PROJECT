    "@capacitor/status-bar": "8.0.4",
    "@ionic/pwa-elements": "^3.4.0",
    "ionicons": "^8.1.0",
    "@ionic/react": "9.0.7",
    "@ionic/react-router": "9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
