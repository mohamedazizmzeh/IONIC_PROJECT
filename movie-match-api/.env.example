# ============ SERVEUR ============
PORT=3000

# ============ BASE DE DONNÉES ============
# Remplacer <user>, <password> et l'URL du cluster par tes vraies valeurs MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/moviematch?retryWrites=true&w=majority&appName=Cluster0

# ============ AUTHENTIFICATION JWT ============
# Générer une chaîne aléatoire longue (min. 32 caractères)
JWT_SECRET=your_long_random_secret_change_me
JWT_EXPIRES=7d